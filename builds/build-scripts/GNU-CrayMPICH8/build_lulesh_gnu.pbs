#!/usr/bin/env bash
# PBS build job for the GNU LULESH build; submit from this directory with
# outputs/ present; inputs are the synchronized repository and default modules.
#PBS -N build_lulesh_gnu
#PBS -j n
#PBS -o outputs/GNU-CrayMPICH8_v1.o
#PBS -e outputs/GNU-CrayMPICH8_v1.e
#PBS -l select=1:ncpus=8:mem=4gb
#PBS -l walltime=00:20:00

set -euo pipefail
cd "${PBS_O_WORKDIR}"
module swap PrgEnv-cray PrgEnv-gnu/8.3.3
export SOURCE_COMMIT="3e01c40b3281aadb7f996525cdd4a3354f6d3801"
export BUILD_JOBS="${BUILD_JOBS:-8}"
./build_lulesh_gnu.sh

