#!/usr/bin/env bash
# Build the CCE13 LULESH -O2 variant from this directory; input is the
# Aspire2A source tree and loaded CCE/MPI environment; outputs are PBS logs.
#PBS -N build_lulesh_cce13_o2
#PBS -j n
#PBS -o outputs/CCE13-CrayMPICH8-O2_v1.o
#PBS -e outputs/CCE13-CrayMPICH8-O2_v1.e
#PBS -l select=1:ncpus=8:mem=4gb
#PBS -l walltime=00:20:00

set -euo pipefail
cd "${PBS_O_WORKDIR}"
module list
export BUILD_JOBS="${BUILD_JOBS:-8}"
./build_lulesh_cce13_o2.sh
