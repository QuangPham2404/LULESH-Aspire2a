#!/usr/bin/env bash
# PBS LULESH AOCC smoke run; submit from this directory after the AOCC build
# succeeds; inputs are the synchronized binary and the fixed -s 10 argument.
#PBS -N lulesh_aocc_smoke_s10
#PBS -j n
#PBS -o outputs/AOCC-CrayMPICH8-smoke-s10_v1.o
#PBS -e outputs/AOCC-CrayMPICH8-smoke-s10_v1.e
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=1gb
#PBS -l walltime=00:10:00

set -euo pipefail

cd "${PBS_O_WORKDIR}"
module swap PrgEnv-cray PrgEnv-aocc/8.3.3

REPO_ROOT="/home/users/ntu/pham0094/scratch/LULESH-Aspire2a"
BINARY="${REPO_ROOT}/builds/source/LULESH-newWF/build-AOCC-CrayMPICH8-Release/lulesh2.0"
SOURCE_COMMIT="3e01c40b3281aadb7f996525cdd4a3354f6d3801"
export OMP_NUM_THREADS=1

echo "experiment_id: AOCC-CrayMPICH8-smoke-s10"
echo "attempt: AOCC-CrayMPICH8-smoke-s10_v1"
echo "pbs_job_id: ${PBS_JOBID:-unknown}"
echo "timestamp_utc: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "hostname: $(hostname)"
echo "binary: ${BINARY}"
echo "source_commit: ${SOURCE_COMMIT}"
echo "input_parameters: -s 10"
echo "mpi_tasks: 1"
echo "openmp_threads: ${OMP_NUM_THREADS}"
echo "requested_resources: select=1:ncpus=1:mpiprocs=1:mem=1gb, walltime=00:10:00"
echo

for tool in mpirun; do
  command -v "${tool}" >/dev/null 2>&1 || {
    echo "ERROR: required tool not found: ${tool}" >&2
    exit 1
  }
done
[[ -x "${BINARY}" ]] || {
  echo "ERROR: expected successful-build binary is missing or not executable: ${BINARY}" >&2
  exit 1
}

echo '== loaded modules =='
module list 2>&1
echo
echo '== toolchain =='
echo "CC: $(command -v CC)"
echo "mpirun: $(command -v mpirun)"
CC --version
mpirun --version
echo

echo '== run =='
mpirun -np 1 "${BINARY}" -s 10
