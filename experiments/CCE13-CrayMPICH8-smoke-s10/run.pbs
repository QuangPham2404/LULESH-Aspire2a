#!/usr/bin/env bash
#PBS -N lulesh_smoke_s10
#PBS -j n
#PBS -o smoke_s10_v1.o
#PBS -e smoke_s10_v1.e
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=1gb
#PBS -l walltime=00:10:00

set -euo pipefail

cd "$PBS_O_WORKDIR"

REPO_ROOT="/home/users/ntu/pham0094/scratch/LULESH-Aspire2a"
BINARY="${REPO_ROOT}/builds/source/LULESH/build-CCE13-CrayMPICH8-Release/lulesh2.0"

echo "experiment_id: CCE13-CrayMPICH8-smoke-s10"
echo "attempt: v1"
echo "pbs_job_id: ${PBS_JOBID:-unknown}"
echo "timestamp_utc: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "hostname: $(hostname)"
echo "pbs_o_workdir: ${PBS_O_WORKDIR:-unknown}"
echo "binary: ${BINARY}"
echo "input_parameters: -s 10"
echo "requested_resources: select=1:ncpus=1:mpiprocs=1:mem=1gb, walltime=00:10:00"
echo

echo "== loaded modules =="
module list
echo

echo "== toolchain =="
for tool in CC cc ftn mpirun mpiexec; do
  if command -v "${tool}" >/dev/null 2>&1; then
    echo "${tool}: $(command -v "${tool}")"
  else
    echo "${tool}: not found"
  fi
done
echo

echo "== versions =="
CC --version
mpirun --version
echo

if [[ ! -x "${BINARY}" ]]; then
  echo "ERROR: expected LULESH binary is missing or not executable: ${BINARY}" >&2
  exit 1
fi

echo "== run =="
set -x
mpirun -np 1 "${BINARY}" -s 10
