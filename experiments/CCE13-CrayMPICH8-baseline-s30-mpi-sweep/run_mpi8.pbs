#!/usr/bin/env bash
# Submit the CCE13 -s30 MPI-rank-8 scaling case from this directory.
#PBS -N lulesh_cce13_mpi8_s30
#PBS -j n
#PBS -o outputs/CCE13-CrayMPICH8-baseline-s30-mpi8_v1.o
#PBS -e outputs/CCE13-CrayMPICH8-baseline-s30-mpi8_v1.e
#PBS -l select=1:ncpus=8:mpiprocs=8:mem=16gb
#PBS -l walltime=00:10:00
set -euo pipefail
export MPI_RANKS=8
export EXPERIMENT_ID=CCE13-CrayMPICH8-baseline-s30-mpi8
export REQUESTED_RESOURCES='select=1:ncpus=8:mpiprocs=8:mem=16gb,walltime=00:10:00'
./run_lulesh_cce13_mpi.pbs
