#!/usr/bin/env bash
# Submit the CCE13 -s30 MPI-rank-27 scaling case from this directory.
#PBS -N lulesh_cce13_mpi27_s30
#PBS -j n
#PBS -o outputs/CCE13-CrayMPICH8-baseline-s30-mpi27_v1.1.o
#PBS -e outputs/CCE13-CrayMPICH8-baseline-s30-mpi27_v1.1.e
#PBS -l select=1:ncpus=27:mpiprocs=27:mem=16gb
#PBS -l walltime=00:10:00
set -euo pipefail
export MPI_RANKS=27
export EXPERIMENT_ID=CCE13-CrayMPICH8-baseline-s30-mpi27
export REQUESTED_RESOURCES='select=1:ncpus=27:mpiprocs=27:mem=16gb,walltime=00:10:00'
bash /home/users/ntu/pham0094/scratch/LULESH-Aspire2a/experiments/CCE13-CrayMPICH8-baseline-s30-mpi-sweep/run_lulesh_cce13_mpi.pbs
