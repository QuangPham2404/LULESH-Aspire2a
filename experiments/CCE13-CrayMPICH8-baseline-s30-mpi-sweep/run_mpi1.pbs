#!/usr/bin/env bash
# Submit the CCE13 -s30 MPI-rank-1 scaling case from this directory.
#PBS -N lulesh_cce13_mpi1_s30
#PBS -j n
#PBS -o outputs/CCE13-CrayMPICH8-baseline-s30-mpi1_v1.o
#PBS -e outputs/CCE13-CrayMPICH8-baseline-s30-mpi1_v1.e
#PBS -l select=1:ncpus=1:mpiprocs=1:mem=16gb
#PBS -l walltime=00:10:00
set -euo pipefail
export MPI_RANKS=1
export EXPERIMENT_ID=CCE13-CrayMPICH8-baseline-s30-mpi1
export REQUESTED_RESOURCES='select=1:ncpus=1:mpiprocs=1:mem=16gb,walltime=00:10:00'
./run_lulesh_cce13_mpi.pbs
