export OMP_THREADS=16
export EXPERIMENT_ID=CCE13-CrayMPICH8-baseline-s30-omp16
export REQUESTED_RESOURCES='select=1:ncpus=16:mpiprocs=1:mem=16gb,walltime=00:10:00'
bash /home/users/ntu/pham0094/scratch/LULESH-Aspire2a/experiments/CCE13-CrayMPICH8-baseline-s30-omp-sweep/run_lulesh_cce13_omp.pbs
