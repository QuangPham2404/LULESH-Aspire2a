#!/usr/bin/env bash
# Submit the CCE13 -s30 OpenMP-thread-16 scaling case from this directory.
#PBS -N lulesh_cce13_omp16_s30
#PBS -j n
#PBS -o outputs/CCE13-CrayMPICH8-baseline-s30-omp16_v1.o
#PBS -e outputs/CCE13-CrayMPICH8-baseline-s30-omp16_v1.e
